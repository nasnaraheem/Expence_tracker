#======================expenses===============

#api call for list expense of user
###
GET http://127.0.0.1:8000/expenses/
Accept: application/json
Authorization: Basic django:password@123

#api call for create expense
###
POST http://127.0.0.1:8000/expenses/
Content-Type: application/json
Authorization: Basic django:password@123

{
    "title" : "travel",
    "amount" : 1000
    
}

#api call for fetiching details
###
GET http://127.0.0.1:8000/expenses/1/
Accept: application/json
Authorization: Basic django:password@123

#api call for update 
###
PUT http://127.0.0.1:8000/expenses/1/
Content-Type: application/json
Authorization: Basic django:password@123

{
  "id": 1,
  "title": "snacks",
  "category": "food",
  "amount": "300.00",
  "description": null,
  "payment_method": "upi",
  "created_at": "2026-11-12T04:56:01.331401Z",
  "bill_image": null,
  "owner": 1
}

#api call for delete
###
DELETE http://127.0.0.1:8000/expenses/2/
Authorization: Basic react:password@123
